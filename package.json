{
  "name": "india-path-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "prisma migrate dev --name init && prisma db seed",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "prisma generate",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:ios": "node node_modules/@capacitor/cli/bin/capacitor open ios",
    "cap:android": "node node_modules/@capacitor/cli/bin/capacitor open android"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^2.18.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/json-schema": "^7.0.15",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.5.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-leaflet": "^2.8.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
